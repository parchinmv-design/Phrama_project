<Window x:Class="PharmaOrderApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="PharmaFlow"
        Height="920"
        Width="1500"
        MinHeight="780"
        MinWidth="1220"
        Background="{StaticResource CreamBrush}">
    <Grid>
        <Grid x:Name="LoginPanel">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="1.25*" />
            </Grid.ColumnDefinitions>

            <Border Margin="32" Padding="32" CornerRadius="30" Background="{StaticResource InkBrush}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="PharmaFlow" FontSize="40" FontWeight="Bold" Foreground="White" />
                    <TextBlock Margin="0,12,0,22"
                               Text="Аптечная система с отдельными сценариями для клиента, менеджера поставок и администратора сети."
                               Foreground="#D8E7E3"
                               TextWrapping="Wrap"
                               FontSize="17" />

                    <Border Background="#22385D" CornerRadius="22" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Что уже есть" FontSize="19" FontWeight="SemiBold" Foreground="White" />
                            <TextBlock Margin="0,10,0,0"
                                       Foreground="#D8E7E3"
                                       TextWrapping="Wrap"
                                       Text="• Отдельные окна под роли&#x0a;• Регистрация клиента&#x0a;• Поставки, сотрудники и контроль процессов&#x0a;• Расширенный каталог препаратов&#x0a;• Большая БД и ERD" />
                        </StackPanel>
                    </Border>

                    <Border Background="#FFF3DE" CornerRadius="22" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Быстрые входы" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                            <TextBlock Margin="0,8,0,0" Text="admin_master / admin2026" />
                            <TextBlock Text="manager_nsk1 / mng2026A" />
                            <TextBlock Text="manager_nsk2 / mng2026B" />
                            <TextBlock Text="manager_nsk3 / mng2026C" />
                            <TextBlock Text="client_demo / client2026" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Margin="0,32,32,32" Padding="28" CornerRadius="30" Background="White">
                <TabControl>
                    <TabItem Header="Вход">
                        <StackPanel Margin="10">
                            <TextBlock Text="Вход в систему" FontSize="28" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                            <TextBlock Margin="0,8,0,18"
                                       Text="Клиент работает с каталогом и заказами. Менеджер управляет поставками. Администратор контролирует сотрудников и сеть."
                                       Foreground="#5E6A73"
                                       TextWrapping="Wrap" />

                            <TextBlock Text="Логин" FontWeight="SemiBold" />
                            <TextBox x:Name="LoginBox" Text="client_demo" />
                            <TextBlock Text="Пароль" FontWeight="SemiBold" Margin="0,8,0,0" />
                            <PasswordBox x:Name="PasswordBox" Password="client2026" />

                            <WrapPanel Margin="0,14,0,0">
                                <Button Content="Войти" Height="42" Width="160" Click="Login_Click" />
                                <Button Content="Гостевой режим" Height="42" Width="170" Background="#6C757D" Click="Guest_Click" />
                            </WrapPanel>
                            <TextBlock x:Name="LoginMessage" Foreground="#C1121F" TextWrapping="Wrap" Margin="4,12,4,0" />
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="Регистрация клиента">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10">
                                <TextBlock Text="Новый клиент" FontSize="28" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                                <TextBlock Margin="0,8,0,18"
                                           Text="Саморегистрация доступна только клиенту. Менеджеров и администраторов создаёт администратор."
                                           Foreground="#5E6A73"
                                           TextWrapping="Wrap" />

                                <TextBlock Text="ФИО" FontWeight="SemiBold" />
                                <TextBox x:Name="RegisterFullNameBox" />
                                <TextBlock Text="Логин" FontWeight="SemiBold" />
                                <TextBox x:Name="RegisterLoginBox" />
                                <TextBlock Text="Пароль" FontWeight="SemiBold" />
                                <PasswordBox x:Name="RegisterPasswordBox" />
                                <TextBlock Text="Телефон" FontWeight="SemiBold" />
                                <TextBox x:Name="RegisterPhoneBox" />
                                <TextBlock Text="Email" FontWeight="SemiBold" />
                                <TextBox x:Name="RegisterEmailBox" />
                                <Button Content="Создать клиента" Height="42" Width="220" Click="RegisterClient_Click" />
                                <TextBlock x:Name="RegisterMessage" Margin="4,10,4,0" TextWrapping="Wrap" Foreground="{StaticResource InkBrush}" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <Grid x:Name="AppPanel" Visibility="Collapsed" Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" CornerRadius="24" Background="{StaticResource InkBrush}" Padding="20" Margin="0,0,0,14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="PharmaFlow" FontSize="30" FontWeight="Bold" Foreground="White" />
                        <TextBlock x:Name="UserLabel" Foreground="#CBE5DD" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="RefreshButton" Content="Синхронизировать" Width="160" Click="Refresh_Click" />
                        <Button Content="Выйти" Width="110" Background="#E76F51" Click="Logout_Click" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <TabControl x:Name="WorkspaceTabs" Grid.Row="1">
                <TabItem x:Name="ClientCatalogTab" Header="Каталог">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.1*" />
                            <ColumnDefinition Width="1.15*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="White" CornerRadius="20" Padding="16" Margin="0,0,10,0">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top">
                                    <TextBlock Text="Каталог препаратов" FontSize="24" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                                    <WrapPanel Margin="0,12,0,12">
                                        <TextBox x:Name="SearchBox" Width="290" TextChanged="Filters_Changed" ToolTip="Поиск по всем препаратам" />
                                        <ComboBox x:Name="CategoryFilter" Width="190" SelectionChanged="Filters_Changed" DisplayMemberPath="Name" />
                                        <ComboBox x:Name="PharmacyFilter" Width="200" SelectionChanged="Filters_Changed" DisplayMemberPath="Name" />
                                        <ComboBox x:Name="SortBox" Width="150" SelectionChanged="Filters_Changed">
                                            <ComboBoxItem Content="Название" IsSelected="True" />
                                            <ComboBoxItem Content="Цена ↑" />
                                            <ComboBoxItem Content="Цена ↓" />
                                            <ComboBoxItem Content="Остаток ↓" />
                                        </ComboBox>
                                    </WrapPanel>
                                    <Border Background="#F3EFE7" CornerRadius="18" Padding="12" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="Витрины по категориям" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                                            <ScrollViewer Height="180" VerticalScrollBarVisibility="Auto">
                                                <WrapPanel x:Name="CategoryShowcasePanel" Margin="0,10,0,0" />
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <DataGrid x:Name="ProductsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                          SelectionMode="Single" SelectionChanged="ProductsGrid_SelectionChanged">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Товар" Binding="{Binding Name}" Width="1.6*" />
                                        <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="1.0*" />
                                        <DataGridTextColumn Header="Аптека" Binding="{Binding Pharmacy}" Width="1.0*" />
                                        <DataGridTextColumn Header="Производитель" Binding="{Binding Manufacturer}" Width="1.0*" />
                                        <DataGridTextColumn Header="Форма" Binding="{Binding Form}" Width="0.8*" />
                                        <DataGridTextColumn Header="Рецепт" Binding="{Binding PrescriptionTitle}" Width="0.8*" />
                                        <DataGridTextColumn Header="Цена" Binding="{Binding PriceTitle}" Width="0.7*" />
                                        <DataGridTextColumn Header="Остаток" Binding="{Binding Stock}" Width="0.6*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>

                        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Background="White" CornerRadius="20" Padding="16" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Карточка препарата" FontSize="21" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                                        <TextBlock x:Name="ProductTitle" Margin="0,12,0,4" Text="Выберите товар" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock x:Name="ProductInfo" TextWrapping="Wrap" Foreground="#4F5D63" />
                                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                            <TextBlock Text="Кол-во:" VerticalAlignment="Center" />
                                            <TextBox x:Name="QuantityBox" Width="60" Text="1" />
                                            <Button x:Name="AddToCartButton" Content="В корзину" Click="AddToCart_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Background="White" CornerRadius="20" Padding="16" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Корзина и оформление" FontSize="21" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                                        <ListBox x:Name="CartList" Height="130" DisplayMemberPath="Display" Margin="0,10,0,8" />
                                        <TextBlock x:Name="CartTotal" FontWeight="Bold" />
                                        <ComboBox x:Name="DeliveryMethodBox" Margin="4,10,4,0">
                                            <ComboBoxItem Content="Самовывоз" IsSelected="True" />
                                            <ComboBoxItem Content="Курьер" />
                                        </ComboBox>
                                        <ComboBox x:Name="PaymentMethodBox" Margin="4,6,4,0">
                                            <ComboBoxItem Content="Оплата при получении" IsSelected="True" />
                                            <ComboBoxItem Content="Карта" />
                                            <ComboBoxItem Content="Наличные" />
                                        </ComboBox>
                                        <TextBox x:Name="OrderCommentBox" Height="52" AcceptsReturn="True" TextWrapping="Wrap" ToolTip="Комментарий к заказу" />
                                        <WrapPanel Margin="0,8,0,0">
                                            <Button Content="Удалить строку" Background="#6C757D" Click="RemoveCartItem_Click" />
                                            <Button x:Name="CreateOrderButton" Content="Оформить заказ" Click="CreateOrder_Click" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <TabItem x:Name="ClientOrdersTab" Header="Мои заказы">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Background="White" CornerRadius="18" Padding="16" Margin="0,0,0,10">
                            <TextBlock x:Name="OrdersCaption" FontSize="24" FontWeight="Bold" Foreground="{StaticResource InkBrush}" Text="Заказы" />
                        </Border>
                        <DataGrid x:Name="OrdersGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" Background="White">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Номер" Binding="{Binding Number}" Width="1.0*" />
                                <DataGridTextColumn Header="Клиент" Binding="{Binding ClientName}" Width="1.2*" />
                                <DataGridTextColumn Header="Аптека" Binding="{Binding Pharmacy}" Width="1.1*" />
                                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="0.9*" />
                                <DataGridTextColumn Header="Доставка" Binding="{Binding DeliveryMethodTitle}" Width="0.9*" />
                                <DataGridTextColumn Header="Сумма" Binding="{Binding Total}" Width="0.8*" />
                                <DataGridTextColumn Header="Создан" Binding="{Binding CreatedAt}" Width="1.0*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem x:Name="ManagerTab" Header="Окно менеджера" Visibility="Collapsed">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="1.0*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="White" CornerRadius="20" Padding="16" Margin="0,0,10,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top"
                                           Text="Заявки на поставки и контроль ассортимента"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource InkBrush}"
                                           Margin="0,0,0,12" />
                                <DataGrid x:Name="SupplyGrid" AutoGenerateColumns="False" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Заявка" Binding="{Binding Number}" Width="0.9*" />
                                        <DataGridTextColumn Header="Аптека" Binding="{Binding Pharmacy}" Width="1.0*" />
                                        <DataGridTextColumn Header="Поставщик" Binding="{Binding Supplier}" Width="1.0*" />
                                        <DataGridTextColumn Header="Товар" Binding="{Binding Product}" Width="1.1*" />
                                        <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="0.6*" />
                                        <DataGridTextColumn Header="Приоритет" Binding="{Binding Priority}" Width="0.8*" />
                                        <DataGridTextColumn Header="Статус" Binding="{Binding StatusTitle}" Width="0.8*" />
                                        <DataGridTextColumn Header="Нужно к" Binding="{Binding NeededBy}" Width="0.8*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>

                        <StackPanel Grid.Column="1">
                            <Border Background="White" CornerRadius="20" Padding="16" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Создать новую заявку" FontSize="21" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                                    <ComboBox x:Name="SupplyProductBox" DisplayMemberPath="Name" />
                                    <ComboBox x:Name="SupplySupplierBox" DisplayMemberPath="Name" />
                                    <ComboBox x:Name="SupplyPharmacyBox" DisplayMemberPath="Name" />
                                    <TextBox x:Name="SupplyQuantityBox" ToolTip="Количество" Text="10" />
                                    <ComboBox x:Name="SupplyPriorityBox">
                                        <ComboBoxItem Content="Высокий" />
                                        <ComboBoxItem Content="Средний" IsSelected="True" />
                                        <ComboBoxItem Content="Низкий" />
                                    </ComboBox>
                                    <DatePicker x:Name="SupplyNeededDatePicker" SelectedDate="{x:Static sys:DateTime.Now}" />
                                    <TextBox x:Name="SupplyCommentBox" Height="64" AcceptsReturn="True" TextWrapping="Wrap" ToolTip="Комментарий к поставке" />
                                    <Button Content="Создать заявку" Click="CreateSupplyRequest_Click" />
                                </StackPanel>
                            </Border>

                            <Border Background="White" CornerRadius="20" Padding="16" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Редактор ассортимента своей аптеки" FontSize="21" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                                    <TextBox x:Name="EditName" ToolTip="Название" />
                                    <ComboBox x:Name="EditCategoryBox" DisplayMemberPath="Name" />
                                    <ComboBox x:Name="EditManufacturerBox" DisplayMemberPath="Name" />
                                    <ComboBox x:Name="EditFormBox" DisplayMemberPath="Name" />
                                    <ComboBox x:Name="EditPharmacyBox" DisplayMemberPath="Name" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox x:Name="EditPrice" Width="100" ToolTip="Цена" />
                                        <TextBox x:Name="EditStock" Width="100" ToolTip="Остаток" />
                                        <CheckBox x:Name="EditPrescription" Content="По рецепту" VerticalAlignment="Center" Margin="8,0" />
                                    </StackPanel>
                                    <TextBox x:Name="EditDescription" Height="70" TextWrapping="Wrap" AcceptsReturn="True" ToolTip="Описание" />
                                    <WrapPanel>
                                        <Button Content="Новый товар" Background="#6C757D" Click="NewProduct_Click" />
                                        <Button Content="Сохранить" Click="SaveProduct_Click" />
                                        <Button Content="Скрыть" Background="#C1121F" Click="DeleteProduct_Click" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Background="#EEF7F5" CornerRadius="20" Padding="16">
                                <TextBlock Text="Менеджер здесь работает только с поставками и ассортиментом своей аптеки. Клиентские каталоги и заказы ему не мешают." TextWrapping="Wrap" Foreground="#44545A" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <TabItem x:Name="AdminTab" Header="Окно администратора" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10">
                            <UniformGrid Columns="3" Margin="0,0,0,12">
                                <Border Background="White" CornerRadius="18" Padding="16" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="Клиенты" FontSize="18" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                                        <TextBlock x:Name="KpiClients" FontSize="30" FontWeight="Bold" />
                                    </StackPanel>
                                </Border>
                                <Border Background="White" CornerRadius="18" Padding="16" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="Открытые заказы" FontSize="18" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                                        <TextBlock x:Name="KpiOrders" FontSize="30" FontWeight="Bold" />
                                    </StackPanel>
                                </Border>
                                <Border Background="White" CornerRadius="18" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="Открытые поставки" FontSize="18" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                                        <TextBlock x:Name="KpiSupply" FontSize="30" FontWeight="Bold" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.25*" />
                                    <ColumnDefinition Width="0.95*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <Border Background="White" CornerRadius="18" Padding="16" Margin="0,0,10,10">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="Сотрудники" FontSize="22" FontWeight="Bold" Foreground="{StaticResource InkBrush}" Margin="0,0,0,10" />
                                            <DataGrid x:Name="EmployeesGrid" AutoGenerateColumns="False" IsReadOnly="True">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="1.2*" />
                                                    <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="0.9*" />
                                                    <DataGridTextColumn Header="Роль" Binding="{Binding RoleTitle}" Width="0.8*" />
                                                    <DataGridTextColumn Header="Аптека" Binding="{Binding Pharmacy}" Width="1.0*" />
                                                    <DataGridTextColumn Header="Статус" Binding="{Binding StatusTitle}" Width="0.8*" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </DockPanel>
                                    </Border>

                                    <Border Background="White" CornerRadius="18" Padding="16" Margin="0,0,10,10">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="Клиенты и активность" FontSize="22" FontWeight="Bold" Foreground="{StaticResource InkBrush}" Margin="0,0,0,10" />
                                            <DataGrid x:Name="ClientsGrid" AutoGenerateColumns="False" IsReadOnly="True">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Клиент" Binding="{Binding FullName}" Width="1.2*" />
                                                    <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="0.9*" />
                                                    <DataGridTextColumn Header="Заказы" Binding="{Binding OrdersCount}" Width="0.7*" />
                                                    <DataGridTextColumn Header="Сумма" Binding="{Binding TotalSpent}" Width="0.8*" />
                                                    <DataGridTextColumn Header="Баллы" Binding="{Binding LoyaltyPoints}" Width="0.7*" />
                                                    <DataGridTextColumn Header="Статус" Binding="{Binding StatusTitle}" Width="0.8*" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </DockPanel>
                                    </Border>

                                    <Border Background="White" CornerRadius="18" Padding="16">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="Журнал действий" FontSize="22" FontWeight="Bold" Foreground="{StaticResource InkBrush}" Margin="0,0,0,10" />
                                            <DataGrid x:Name="AuditGrid" AutoGenerateColumns="False" IsReadOnly="True">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Когда" Binding="{Binding OccurredAt}" Width="1.0*" />
                                                    <DataGridTextColumn Header="Кто" Binding="{Binding Actor}" Width="0.9*" />
                                                    <DataGridTextColumn Header="Действие" Binding="{Binding ActionType}" Width="0.9*" />
                                                    <DataGridTextColumn Header="Описание" Binding="{Binding Details}" Width="1.8*" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <Border Background="White" CornerRadius="18" Padding="16" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="Новый сотрудник" FontSize="21" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                                            <TextBlock Text="Роль" FontWeight="SemiBold" Margin="4,10,4,0" />
                                            <ComboBox x:Name="NewEmployeeRoleBox">
                                                <ComboBoxItem Content="Manager" IsSelected="True" />
                                                <ComboBoxItem Content="Admin" />
                                            </ComboBox>
                                            <TextBlock Text="ФИО сотрудника" FontWeight="SemiBold" Margin="4,6,4,0" />
                                            <TextBox x:Name="NewEmployeeNameBox" ToolTip="ФИО сотрудника" />
                                            <TextBlock Text="Логин" FontWeight="SemiBold" Margin="4,6,4,0" />
                                            <TextBox x:Name="NewEmployeeLoginBox" ToolTip="Логин" />
                                            <TextBlock Text="Пароль" FontWeight="SemiBold" Margin="4,6,4,0" />
                                            <PasswordBox x:Name="NewEmployeePasswordBox" ToolTip="Пароль" />
                                            <TextBlock Text="Телефон" FontWeight="SemiBold" Margin="4,6,4,0" />
                                            <TextBox x:Name="NewEmployeePhoneBox" ToolTip="Телефон" />
                                            <TextBlock Text="Email" FontWeight="SemiBold" Margin="4,6,4,0" />
                                            <TextBox x:Name="NewEmployeeEmailBox" ToolTip="Email" />
                                            <TextBlock Text="Закреплённая аптека" FontWeight="SemiBold" Margin="4,6,4,0" />
                                            <ComboBox x:Name="NewEmployeePharmacyBox" DisplayMemberPath="Name" />
                                            <Button Content="Создать сотрудника" Click="CreateEmployee_Click" />
                                        </StackPanel>
                                    </Border>

                                    <Border Background="White" CornerRadius="18" Padding="16" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="Статус сотрудника" FontSize="21" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                                            <TextBlock Text="Выберите сотрудника в таблице и примените действие." TextWrapping="Wrap" Foreground="#5E6A73" Margin="0,6,0,10" />
                                            <Button Content="Активировать" Click="ActivateEmployee_Click" />
                                            <Button Content="Уволить" Background="#D97706" Click="DismissEmployee_Click" />
                                            <Button Content="Заблокировать" Background="#C1121F" Click="BlockEmployee_Click" />
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#EEF7F5" CornerRadius="18" Padding="16">
                                        <TextBlock Text="Администратор здесь не покупает лекарства. Он управляет людьми, контролирует процессы и следит за состоянием сети." TextWrapping="Wrap" Foreground="#44545A" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <Border Grid.Row="2" Background="#EEF7F5" CornerRadius="14" Padding="10" Margin="0,14,0,0">
                <TextBlock x:Name="StatusLabel" Text="Готово" Foreground="{StaticResource InkBrush}" />
            </Border>
        </Grid>
    </Grid>
</Window>
